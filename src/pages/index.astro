---
import Layout from '../layouts/Layout.astro';
import HeaderCV from '../components/HeaderCV.astro';
import Skills from '../components/Skills.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import Workspace from '../components/Workspace.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const name = "VICSE JEFER ORE SOTO";
const role = "Senior Backend Developer | Node.js | NestJS | AWS Cloud";
const description = "Backend Developer specialized in microservices on AWS Cloud with over 5 years of experience. Expert in serverless architectures, DDD, Clean Architecture, and automated deployments.";
const email = "vicseore@gmail.com";

const experiences = [
  {
    date: "February 2025 — Present",
    role: "Senior Backend Developer – NestJS | AWS CLOUD",
    company: "QDS (Client: Kasnet)",
    description: [
      "Implemented a secure Backoffice authentication module with AWS Cognito, OTP, and KMS, and automated cloud infrastructure using Pulumi (IaC).",
      "Integrated digital wallet services with EEDE (Gmoney and Ligo) via Apache Kafka and webhooks, securing real-time transactions.",
      "Optimized agent affiliation pipelines and contributed to end-to-end development of React Native mobile and React web backoffice apps.",
      "Accelerated development workflows leveraging AWS Kiro Code Agent, Amazon Q (Sonnet, Opus), and custom MCP extensions."
    ],
    tags: ["NestJS", "AWS Cognito", "Pulumi", "Kafka", "KMS", "RDS", "ECS AWS", "ALB", "AWS API Gateway", "AWS SQS", "AWS Lambda"],
    isLatest: true,
    side: "left" as const
  },
  {
    date: "November 2023 — December 2024",
    role: "Backend Developer – NestJS",
    company: "Workmate/Chile",
    description: [
      "Implemented microservices dedicated to the auditing of contracts and subcontracts.",
      "Developed an inspection module to audit workers under CODELCO regulations.",
      "Updated the company's shared npm package @sucal/shared, adding interfaces, helper classes, reusable functions, and a PDF creation template.",
      "Generated automated and structured PDF reports for compliance tracking.",
      "Developed microservices for document and image uploading to AWS S3 using presigned URLs with the AWS SDK."
    ],
    tags: ["NestJS", "TypeORM", "JWT", "PostgreSQL", "Swagger", "AWS Lambda", "Cognito", "S3", "Docker"],
    side: "right" as const
  },
  {
    date: "July 2022 — November 2023",
    role: "Senior Backend Developer – NodeJS | AWS | Serverless",
    company: "Indra/Perú",
    description: [
      "Developed and maintained microservices for a corporate wellness platform (EstarBien).",
      "Utilized Serverless Framework with AWS Lambda, S3, SNS, SQS, and SES services.",
      "Applied DDD (Domain-Driven Design) and Hexagonal Architecture principles to decouple business logic.",
      "Developed unit and integration tests using BDD methodologies (Gherkin, Jest).",
      "Built Lambda functions for on-demand and bulk email delivery integrated with NodeJS, SES, SQS, and SNS.",
      "Integrated microservices with ContentStack webhooks for dynamic and real-time content management on the EstarBien platform."
    ],
    tags: ["NodeJS", "AWS Serverless", "DDD", "Hexagonal", "Jest", "BDD", "SES", "SQS", "ContentStack"],
    side: "left" as const
  },
  {
    date: "November 2021 — July 2022",
    role: "Backend Developer – NodeJS | AWS",
    company: "Jooycar/Chile",
    description: [
      "Optimized notification components utilizing AWS Lambda and Redis Cache for fast delivery.",
      "Developed scalable microservices using Express, MongoDB, and Redis.",
      "Implemented authentication mechanisms using Cognito and AWS CDK for fleet management systems in the US.",
      "Developed a web-based auto insurance quoting application using VueJS, Pinia, and TypeScript."
    ],
    tags: ["NodeJS", "Express", "MongoDB", "Redis", "Cognito", "CDK", "VueJS", "Pinia", "TypeScript"],
    side: "right" as const
  },
  {
    date: "November 2020 — September 2021",
    role: "Backend Developer – NodeJS | AWS | Serverless",
    company: "Tata Consultancy Services/Perú",
    description: [
      "Rimac Seguros Client.",
      "Created Lambda functions for the automated loading of NPS customer satisfaction surveys.",
      "Developed Lambda functions exposed via AWS API Gateway for integration with Salesforce platforms.",
      "Validated entity data structures and mapped core APIs for Salesforce Marketing Cloud.",
      "Transferred and synced data from GCP to Salesforce using Google Cloud Functions in Python, Cloud Scheduler, and Skyvia."
    ],
    tags: ["NodeJS", "AWS Serverless", "GCP", "Cloud Functions", "Python", "Salesforce", "API Gateway"],
    side: "left" as const
  },
  {
    date: "2020",
    role: "Backend Developer – Spring Boot | AWS",
    company: "Global66/Chile",
    description: [
      "Developed microservices with Spring Boot to enable Spain as an origin country for international money transfers.",
      "Utilized AWS CodeCommit, RDS, API Gateway, CodePipeline, and CloudWatch for secure cloud deployments and monitoring.",
      "Implemented Liquibase for database schema migration management and Retrofit for external integrations.",
      "Implemented a microservice integrated with Google Sheets to update system tables in real time."
    ],
    tags: ["Spring Boot", "JPA", "SQL Server", "RxJava", "Retrofit", "SpotBugs", "JUnit", "Jacoco", "SonarQube", "Jenkins", "RDS"],
    side: "right" as const
  },
  {
    date: "2019",
    role: "Backend Developer – Spring Boot | AWS",
    company: "Everis (BCP)/Lima",
    description: [
      "Built REST APIs for merchant payment solutions, BCP's Mobile Banking application, and auxiliary financial systems.",
      "Designed and developed business, application, and channel-tier microservices."
    ],
    tags: ["Java", "Spring Boot", "JPA", "SQL Server", "RxJava", "Retrofit", "SpotBugs", "JUnit", "Jacoco", "SonarQube", "Jenkins"],
    side: "left" as const
  }
];
---

<Layout title={`${name} - ${role}`}>
  <HeaderCV 
    name={name} 
    role={role} 
    description={description} 
  />
  
  <main class="flex-grow pt-20">
    <!-- Tech Stack Section -->
    <Skills />

    <!-- Experience Section -->
    <section class="py-section-gap px-margin-mobile md:px-gutter max-w-container-max mx-auto" id="experience">
      <h2 class="font-headline-lg text-headline-lg text-on-surface mb-16">
        <span class="text-primary-fixed-dim font-code-sm text-code-sm align-middle mr-2">02.</span> Professional Trajectory
      </h2>
      
      <div class="relative border-l-2 border-outline-variant/30 ml-4 md:ml-0 md:border-none md:grid md:grid-cols-[1fr_auto_1fr] md:gap-x-8">
        <!-- Decorative Timeline Line for Desktop -->
        <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-outline-variant/30 transform -translate-x-1/2"></div>
        
        {experiences.map((exp) => (
          <ExperienceItem {...exp} />
        ))}
      </div>
    </section>

    <!-- Workspace Section -->
    <Workspace />

    <!-- Contact Section -->
    <Contact email={email} />
  </main>

  <Footer name={name} />
</Layout>
