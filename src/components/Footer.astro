---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  name: string;
  lang: Lang;
}

const { name, lang } = Astro.props;
const t = useTranslations(lang);
const footer = t('footer');
const currentYear = new Date().getFullYear();
---

<footer class="w-full py-12 bg-surface-container-lowest border-t border-outline-variant/20">
  <div class="flex flex-col md:flex-row justify-between items-center gap-8 px-gutter max-w-container-max mx-auto">
    <div class="font-label-caps text-label-caps text-primary">
      {name}
    </div>
    <nav class="flex gap-6 font-code-sm text-code-sm">
      <a class="text-on-tertiary-container hover:text-primary-fixed-dim underline-offset-4 hover:underline opacity-80 hover:opacity-100 transition-opacity" href="https://github.com/vicse" target="_blank" rel="noopener noreferrer">Github</a>
      <a class="text-on-tertiary-container hover:text-primary-fixed-dim underline-offset-4 hover:underline opacity-80 hover:opacity-100 transition-opacity" href="https://www.linkedin.com/in/vicseoresoto/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
    <div class="font-code-sm text-code-sm text-tertiary-fixed-dim text-center md:text-right">
      © {currentYear} {name}. {footer.engineered}
    </div>
  </div>
</footer>
