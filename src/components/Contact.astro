---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  email: string;
  lang: Lang;
}

const { email, lang } = Astro.props;
const t = useTranslations(lang);
const contact = t('contact');
---

<section class="py-section-gap px-margin-mobile md:px-gutter max-w-container-max mx-auto text-center" id="contact">
  <span class="font-code-sm text-code-sm text-primary-fixed-dim mb-4 block">{contact.sectionNum}</span>
  <h2 class="font-headline-xl text-headline-xl text-on-surface mb-6">{contact.title}</h2>
  <p class="font-body-md text-body-md text-on-surface-variant max-w-xl mx-auto mb-12">
    {contact.description}
  </p>
  <a class="inline-flex items-center gap-2 px-8 py-4 border border-primary-fixed-dim text-primary-fixed-dim font-label-caps text-label-caps rounded hover:bg-primary-fixed-dim/10 transition-colors group" href={`mailto:${email}`}>
    <span class="material-symbols-outlined group-hover:rotate-12 transition-transform">mail</span> {contact.button}
  </a>
</section>
