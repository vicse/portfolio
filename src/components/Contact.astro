---
interface Props {
  email: string;
}

const { email } = Astro.props;
---

<section class="py-section-gap px-margin-mobile md:px-gutter max-w-container-max mx-auto text-center" id="contact">
  <span class="font-code-sm text-code-sm text-primary-fixed-dim mb-4 block">04. What's Next?</span>
  <h2 class="font-headline-xl text-headline-xl text-on-surface mb-6">Let's Build Something Together</h2>
  <p class="font-body-md text-body-md text-on-surface-variant max-w-xl mx-auto mb-12">
    I'm currently open for new opportunities. Whether you have a question or just want to say hi, I'll try my best to get back to you!
  </p>
  <a class="inline-flex items-center gap-2 px-8 py-4 border border-primary-fixed-dim text-primary-fixed-dim font-label-caps text-label-caps rounded hover:bg-primary-fixed-dim/10 transition-colors group" href={`mailto:${email}`}>
    <span class="material-symbols-outlined group-hover:rotate-12 transition-transform">mail</span> Say Hello
  </a>
</section>
